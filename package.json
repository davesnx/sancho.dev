{
  "name": "sancho.dev",
  "version": "0.1.1",
  "scripts": {
    "dev": "next dev -p 3005",
    "prebuild": "SKIP_GITHUB_FETCH=1 node --experimental-strip-types scripts/fetch-github-repos.mts",
    "build": "next build",
    "start": "npx serve out",
    "generate:og": "node --experimental-strip-types scripts/generate-og-images.mts",
    "generate:og-default": "node --experimental-strip-types scripts/generate-og-images.mts --default-only",
    "build-stats": "ANALYZE=true npm run build",
    "build-clean-prod": "npm run clean && npm run build",
    "build-prod": "npm run build",
    "clean": "rimraf .next out",
    "ts": "next typegen && tsc --noEmit --pretty",
    "format": "biome format --write src scripts --config-path biome.json",
    "lint": "biome lint --write src scripts --config-path biome.json"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@biomejs/biome": "^2.5.12",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "16.2.12",
    "@next/mdx": "16.2.12",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wyw-in-js/babel-preset": "^0.8.1",
    "@wyw-in-js/transform": "^0.8.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "effect": "^3.22.1",
    "esbuild": "^0.28.2",
    "globby": "^16.2.4",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "next-with-linaria": "1.3.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "rimraf": "^6.1.3",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
